# Docker Compose project
COMPOSE_PROJECT_NAME=stockcast
HOST_BIND_ADDRESS=127.0.0.1
TZ=UTC

# PostgreSQL
POSTGRES_DB=stockcast
POSTGRES_USER=stockcast
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_HOST_PORT=5432

# MongoDB
MONGO_INITDB_ROOT_USERNAME=stockcast-admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-local-mongodb-password
MONGO_HOST_PORT=27017

# Redis
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_HOST_PORT=6379

# Kafka
KAFKA_HOST_PORT=29092
KAFKA_UI_HOST_PORT=8088
